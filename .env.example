# ==============================================================================
# SINTIA - ARCHIVO DE CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Entorno y URL de la aplicación
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Base de datos PostgreSQL (en local arranca PGlite o Docker automáticamente)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sintia?schema=public

# Clave de cifrado simétrico para credenciales e integraciones (AES-256-GCM - 32 caracteres)
ENCRYPTION_KEY=sintia_super_secret_aes_key_32b!

# Secreto para sesiones de usuario y cookies firmadas
SESSION_SECRET=sintia_session_jwt_secret_token_change_in_production_key!

# Credenciales del primer administrador (se crea automáticamente en el primer arranque)
ADMIN_EMAIL=admin@sintia.local
ADMIN_PASSWORD=admin123456

# OpenRouter / Gemini IA API (compatible con OpenAI)
# Clave privada. Nunca se envía al navegador.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Modelo por defecto (utilizado también como fallback si el elegido falla)
DEFAULT_MODEL=google/gemini-2.5-flash

# WhatsApp Cloud API (Meta)
# WABA ID, Phone Number ID y token se configuran desde el panel (Canales) y se guardan cifrados.
# APP_URL debe ser pública con HTTPS para que Meta entregue el webhook (en local: cloudflared/ngrok).
# Secreto de la app de Meta (Configuración > Básica): activa la verificación de firma x-hub-signature-256.
META_APP_SECRET=
# Token del webhook (opcional). Si se deja vacío se deriva de SESSION_SECRET.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Modelo multimodal para transcribir audios, leer imágenes/PDF e importar webs (opcional)
GEMINI_MEDIA_MODEL=gemini-2.5-flash

# Integraciones de Google (OAuth 2.0 - Calendar, Gmail, Sheets)
# Un único cliente de tipo "Aplicación web" en Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack Incoming Webhook (URL del webhook proporcionado por Slack)
SLACK_WEBHOOK_URL=

# Stripe (Clave restringida o secreta - test o producción)
STRIPE_SECRET_KEY=

# Webhook saliente genérico (n8n, Make, Zapier)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Cargar automáticamente los datos de demostración de "Clínica Dental Lumen" si la base está vacía
SEED_DEMO=true
